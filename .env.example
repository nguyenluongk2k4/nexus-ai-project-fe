# API URL Configuration
# Leave empty to use relative paths (recommended for production same-domain serving)
# Or set to full URL for cross-domain development (e.g., http://localhost:8000)
VITE_API_URL=

# WebSocket URL
# Leave commented to auto-derive from window.location
# VITE_WS_URL=localhost:8000/api

# Google Analytics 4 Measurement ID
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
